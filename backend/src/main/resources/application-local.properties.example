# =============================================================================
# TestCraft — team configuration (THE ONLY FILE TEAMS NEED TO EDIT)
# Copy this file to: application-local.properties
# Restart the backend. No Java/frontend code changes required.
# =============================================================================

# ── Jira ─────────────────────────────────────────────────────────────────────
jira.base-url=https://YOUR-SITE.atlassian.net
jira.api-path=/rest/api/3
# basic = email + API token (Atlassian Cloud). bearer = PAT / SSO token.
jira.auth-type=basic
jira.username=you@company.com
jira.api-token=YOUR_JIRA_API_TOKEN
jira.bearer-token=

# Optional Jira custom field IDs (leave blank to skip / use issue links)
jira.custom-fields.acceptance-criteria=
jira.custom-fields.linked-stories=

# ── Zephyr ───────────────────────────────────────────────────────────────────
# jira-plugin  = Zephyr on your Jira site (Scale / Squad / ATM)
# scale-cloud  = Zephyr Scale Cloud API (needs a separate Zephyr token)
zephyr.provider=scale-cloud
zephyr.jira-plugin-api-path=/rest/atm/1.0
zephyr.tests-api-path=/rest/tests/1.0
zephyr.tm4j-backend-base-url=https://eu.app.tm4j.smartbear.com/backend
zephyr.default-project-key=KAN
zephyr.default-project-id=10000
zephyr.default-test-case-status=Approved
zephyr.default-priority=Normal
# 0 = let Zephyr choose. Set only if your instance requires a numeric status id.
zephyr.default-test-run-status-id=0

# Used only when zephyr.provider=scale-cloud
zephyr.scale-cloud-base-url=https://api.zephyrscale.smartbear.com/v2
# EU instances (e.g. eu.app.tm4j.smartbear.com) use:
# zephyr.scale-cloud-base-url=https://eu.api.zephyrscale.smartbear.com/v2
zephyr.scale-cloud-api-token=

# Optional until Scale Cloud JWT or TM4J context JWT is available.
# Format: name:numericFolderId (from eu.app.tm4j.smartbear.com foldertree response)
# Example: Test Folder:920586,Demo Test Folder:920588
zephyr.known-folders=

# ── AI ───────────────────────────────────────────────────────────────────────
# mock | gemini | groq | openai | azure-gateway
ai.provider=gemini
ai.temperature=0.7
ai.system-prompt=You are an AI assistant that helps QA teams review stories and generate test cases.

# azure-gateway (MuleSoft / internal gateway)
ai.azure.gateway-url=
ai.azure.deployment-id=
ai.azure.api-key=
ai.azure.api-version=2024-02-15-preview
ai.azure.max-tokens=4096
ai.azure.client-id-header=client_id
ai.azure.client-id=
ai.azure.client-secret-header=client_secret
ai.azure.client-secret=
ai.azure.open-ai-endpoint=

# openai (or any OpenAI-compatible /chat/completions endpoint)
ai.openai.base-url=https://api.openai.com/v1
ai.openai.api-key=
ai.openai.model=gpt-4o-mini
ai.openai.max-tokens=4096

# gemini (recommended demo provider)
ai.gemini.base-url=https://generativelanguage.googleapis.com/v1beta
ai.gemini.api-key=YOUR_GEMINI_API_KEY
ai.gemini.model=gemini-3-flash-preview
ai.gemini.max-tokens=4096

# groq (OpenAI-compatible alternative)
ai.groq.base-url=https://api.groq.com/openai/v1
ai.groq.api-key=
ai.groq.model=llama-3.3-70b-versatile
ai.groq.max-tokens=4096

# ── App ──────────────────────────────────────────────────────────────────────
testcraft.comment-author=testcraft@company.com
# Blank = uses jira.username
testcraft.default-owner=
testcraft.cors-origins=http://localhost:5173,http://localhost:3000
code-host.github.token=
code-host.bitbucket.token=
code-host.bitbucket.username=
code-host.bitbucket.app-password=
jenkins.base-url=https://jenkins.example.com
jenkins.username=
jenkins.api-token=
